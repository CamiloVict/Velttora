{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "velttora.com" }],
      "destination": "https://www.velttora.com/:path*",
      "permanent": true
    },
    {
      "source": "/ai-govtech-colombia.html",
      "destination": "/govtech-software-colombia.html",
      "permanent": true
    },
    {
      "source": "/ai-debt-collection-latam.html",
      "destination": "/debt-collection-software-latam.html",
      "permanent": true
    },
    {
      "source": "/ai-edtech-marketplace.html",
      "destination": "/edtech-marketplace-software.html",
      "permanent": true
    },
    {
      "source": "/ai-fitness-competition-platform.html",
      "destination": "/fitness-competition-platform.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
